            </profile>
            <profile name="⌖ Cañón aullador (barrido)" typeId="f25f-4b13-b724-d5a8" typeName="Weapons" hidden="false" id="2f39-5ea5-91b2-0895">
              <characteristics>
                <characteristic name="ATK" typeId="6056-b741-7cf3-5b43">4</characteristic>
