                <characteristic name="DMG" typeId="dd3e-ef09-5d1a-37b4">4/5</characteristic>
                <characteristic name="WR" typeId="05b8-00a1-69af-14b6">Desgarradora, Pesada (solo Correr), Ráfaga 2", Crueldad humillante*</characteristic>
              </characteristics>
