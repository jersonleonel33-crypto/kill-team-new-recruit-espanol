        <profile name="Campeón" id="d879-425c-3c41-0b53" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Este agente puede realizar dos acciones de 
Combatir durante su activación.
*</characteristic>
          </characteristics>
        </profile>
        <profile name="*Cazacabezas" id="8fb3-30fa-5342-dec1" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Siempre que este agente incapacite a un agente 
con esta arma, tira 1D3:
• Este agente recupera un número de heridas perdidas igual al 
resultado (a menos que tenga una ficha de Furia asesina).
• Hasta el final de la batalla, suma el resultado al atributo Daño 
crítico del cortacráneos de este agente (hasta un máximo de 8).</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
