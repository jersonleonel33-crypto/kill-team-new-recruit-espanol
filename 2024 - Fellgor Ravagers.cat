        <profile name="GOLPE CIRCULAR (1PA)" id="4f9d-e44a-1bd4-6a54" hidden="false" typeId="8f2a-d3d6-1a0c-7fa3" typeName="Unique Actions">
          <characteristics>
            <characteristic name="Unique Action" typeId="ba93-e32d-f1ac-e188">Inflige 1D3+1 daños a cada otro agente a 2" o menos de este 
agente y visible para él.
 Este agente no puede realizar esta acción si tiene una orden 
de ocultarse.</characteristic>
          </characteristics>
