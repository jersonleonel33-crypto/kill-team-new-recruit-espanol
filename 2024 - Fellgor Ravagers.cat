        <profile name="¡Al ataque!" id="d509-5206-1044-025a" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">GAMBITO ESTRATÉGICO si este agente no tiene ninguna de tus fichas de furia asesina. Elige un agente 
EXPOLIAGOR IMPÍO amigo a 6” o menos de este agente y visible para él. Ese agente elegido y cada otro agente EXPOLIAGOR 
IMPÍO amigo a 2” o menos de este agente y visible para él pueden realizar, inmediatamente, una acción libre de Correr en el 
orden que elijas.</characteristic>
          </characteristics>
        </profile>
