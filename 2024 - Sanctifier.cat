        <categoryLink name="SANTIFICADOR" hidden="false" id="f451-7e9f-b34d-039c" targetId="324b-8544-00c4-9e7a" primary="false" />
        <categoryLink name="Imperium" hidden="false" id="43e8-94dd-c566-0e55" targetId="45a7-2d2f-ecfb-1d13" primary="false" />
        <categoryLink name="Adeptus Ministorum" hidden="false" id="651e-2c61-4cdf-f00c" targetId="0d2a-efa4-09e7-4964" primary="false" />
