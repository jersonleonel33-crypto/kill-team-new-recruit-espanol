          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Siempre que un agente a más de 6" de 
este agente dispare contra un agente SANTIFICADOR amigo 
a 6" o menos de este agente, mejora en 1 el atributo Salvación 
de ese agente amigo.</characteristic>
          </characteristics>
        </profile>
        <profile name="BOTIQUÍN (1PA)" typeId="8f2a-d3d6-1a0c-7fa3" typeName="Unique Actions" hidden="false" id="f834-b649-b0b3-628a">
          <characteristics>
            <characteristic name="Unique Action" typeId="ba93-e32d-f1ac-e188">Elige un agente SANTIFICADOR amigo en la zona 
de control de este agente para que recupere hasta 2D3 
heridas perdidas.
 Este agente no puede realizar esta acción si está en la zona 
de control de un agente enemigo.</characteristic>
          </characteristics>
        </profile>
