          </characteristics>
        </profile>
        <profile name="Instructor" id="b189-c9c2-8f18-d961" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Cuando este agente sea 
activado, puedes activar a la vez a 
un agente R-VR CIBERMASTÍN 
OPERATIVO INQUISITORIAL amigo 
apostado. Completa sus activaciones de 
acción en acción en cualquier orden.</characteristic>
          </characteristics>
        </profile>
        <profile name="ORDEN R-VR (0PA)" id="b442-91ca-3572-75cf" hidden="false" typeId="8f2a-d3d6-1a0c-7fa3" typeName="Unique Actions">
          <characteristics>
            <characteristic name="Unique Action" typeId="ba93-e32d-f1ac-e188">Elige un agente R-VR CIBERMASTÍN ESCUADRA DE 
EXACCIÓN amigo y cambia una de sus pautas de ataque.</characteristic>
          </characteristics>
        </profile>
      </profiles>
