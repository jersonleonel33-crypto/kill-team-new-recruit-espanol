            <infoLink name="Silent" id="7577-a239-7a4b-4f66" hidden="false" targetId="1e3c-23c9-c6e2-9f62" type="rule" />
            <infoLink name="Stun" id="fb53-ad1d-2567-7a40" hidden="false" targetId="5ae2-3f29-8635-fd02" type="rule" />
          </infoLinks>
          <profiles>
            <profile name="⌖ Detonador de Espectrocráneo" id="8146-63ea-49b7-09a6" hidden="false" typeId="f25f-4b13-b724-d5a8" typeName="Weapons">
              <characteristics>
                <characteristic name="ATK" typeId="6056-b741-7cf3-5b43">4</characteristic>
                <characteristic name="HIT" typeId="8044-2517-4ef7-33de">3+</characteristic>
                <characteristic name="DMG" typeId="dd3e-ef09-5d1a-37b4">3/4</characteristic>
                <characteristic name="WR" typeId="05b8-00a1-69af-14b6">Área 1", Aturdidora, Limitada 1, Letal 4+, Silenciosa, Detonar*</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="*Detonar" id="b0ba-c35b-255d-e231" hidden="false">
              <description>No elijas un blanco válido. En lugar de eso, el blanco principal es siempre un agente ESPECTROCRÁNEO 
OPERATIVO INQUISITORIAL amigo, y no puede estar a cubierto u ofuscado. Si ese agente no se encuentra en la 
zona de aniquilación, no puedes elegir esta arma.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
