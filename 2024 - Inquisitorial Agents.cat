      <modifiers>
        <modifier field="error" type="add" value="Your kill team (including any REQUISITIONED operatives) cannot include more than one weapon with the Piercing 2 weapon rule.">
          <conditions>
            <condition childId="5ee5-bc3c-c41c-bf40" field="selections" includeChildSelections="true" scope="force" shared="true" type="greaterThan" value="1" />
          </conditions>
        </modifier>
        <modifier field="error" type="add" value="Your kill team (including any REQUISITIONED operatives) cannot include more than three weapons with the Piercing x (excluding Piercing Crits x) weapon rule combined.">
          <conditions>
            <condition childId="52fa-3add-7e15-f499" field="selections" includeChildSelections="true" scope="force" shared="true" type="greaterThan" value="3" />
