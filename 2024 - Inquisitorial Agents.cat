        <categoryLink name="BIBLIOCRÁNEO" id="18e9-f5c6-96c0-fa7a" hidden="false" primary="false" targetId="633b-70ac-5960-fb6d" />
        <categoryLink name="Operative" id="2efc-2b4e-5a49-ce01" hidden="false" primary="true" targetId="cf83-4496-b58e-ac82" />
