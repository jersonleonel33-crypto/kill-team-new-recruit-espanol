        <profile name="PROSPECTOR DE LA ARMADA" id="c68b-5490-5a00-3326" hidden="false" typeId="5156-3fb9-39ce-7bdb" typeName="Operative">
          <characteristics>
            <characteristic name="APL" typeId="bc83-42aa-b7c1-f0b1">2</characteristic>
