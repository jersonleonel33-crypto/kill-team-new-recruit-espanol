        <profile name="Envalentonado" id="da30-e229-cead-886e" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Siempre que un dado de ataque inflija un daño 
de 3 o más a este agente durante un punto de inflexión en el que 
haya realizado una acción de Cargar, tira 1D6: con 5+, resta 1 
a ese daño infligido.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="UNIDAD G.A.T .O. DE LA ARMADA" id="d52a-3eb3-a420-cc70" hidden="false" import="true" type="model">
