            <constraint id="245f-93f5-c067-e6bb" field="selections" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <infoLinks>
            <infoLink name="Heavy" id="f87d-0c87-0460-7d17" hidden="false" targetId="816e-44a2-6be4-6a9a" type="rule" />
            <infoLink name="Limited x" id="ea6b-d109-f954-cc7f" hidden="false" targetId="bf37-3388-40d5-eb72" type="rule" />
