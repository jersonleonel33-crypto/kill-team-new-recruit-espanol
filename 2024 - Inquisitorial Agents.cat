        <profile name="OPERATIVO ILUMINADOR" id="a256-6d91-531b-bb0a" hidden="false" typeId="5156-3fb9-39ce-7bdb" typeName="Operative">
          <characteristics>
            <characteristic name="APL" typeId="bc83-42aa-b7c1-f0b1">2</characteristic>
            <characteristic name="Move" typeId="c996-ffb3-e0b4-ecfa">6"</characteristic>
            <characteristic name="Save" typeId="3241-5548-12d6-f103">5+</characteristic>
            <characteristic name="Wounds" typeId="74f9-f91c-b8fd-89d9">7</characteristic>
          </characteristics>
        </profile>
        <profile name="Sin escapatoria" id="0fe7-beba-5548-fbd1" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Siempre que un agente enemigo vaya a realizar 
una acción de Retroceder estando en la zona de control 
de este agente, puedes usar esta regla. Si lo haces, tira 1D6, 
restando 1 al resultado si ese agente enemigo tiene un atributo 
Heridas más alto que este agente y sumando 1 si ese agente 
enemigo está herido: con 4+, ese agente enemigo no puede 
efectuar esa acción durante esa activación o reacción (los PA 
gastados no se recuperan).</characteristic>
          </characteristics>
        </profile>
        <profile name="Extraer información" id="8259-cd3a-d1eb-907d" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Siempre que un agente enemigo queda 
incapacitado estando en la zona de control de este agente, 
obtienes 1PM.</characteristic>
          </characteristics>
        </profile>
      </profiles>
