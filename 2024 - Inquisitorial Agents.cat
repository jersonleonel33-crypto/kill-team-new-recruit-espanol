        <profile name="Matón" id="0c97-9d3e-699d-b300" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Una vez por punto de inflexión, cuando este agente 
combata o contraataque, en el paso de Resolver dados de 
ataque, puedes ignorar el daño que le haya infligido un éxito 
normal. Si este agente resulta incapacitado durante una acción 
de Combatir, puedes golpear al agente enemigo en esa 
secuencia con uno de tus éxitos sin resolver antes de retirar este 
agente de la zona de aniquilación.</characteristic>
          </characteristics>
        </profile>
      </profiles>
