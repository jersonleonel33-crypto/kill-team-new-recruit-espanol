        <profile name="SEÑAL (1PA)" id="48c6-774f-f408-333a" hidden="false" typeId="8f2a-d3d6-1a0c-7fa3" typeName="Unique Actions">
          <characteristics>
            <characteristic name="Unique Action" typeId="ba93-e32d-f1ac-e188">APOYO. Elige un agente OPERATIVO INQUISITORIAL 
amigo distinto en la zona de aniquilación. Hasta el final de la 
siguiente activación de ese agente, suma 1 a su atributo LPA.
 Este agente puede realizar esta acción dos veces durante su 
activación, pero no puede realizar esta acción si está en la 
zona de control de un agente enemigo.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
