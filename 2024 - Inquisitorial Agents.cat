            <characteristic name="Move" typeId="c996-ffb3-e0b4-ecfa">6"</characteristic>
            <characteristic name="Save" typeId="3241-5548-12d6-f103">5+</characteristic>
            <characteristic name="Wounds" typeId="74f9-f91c-b8fd-89d9">7</characteristic>
          </characteristics>
        </profile>
        <profile name="Transmitir órdenes" id="b984-b0c6-8240-711e" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Una vez por punto de inflexión, cuando este 
agente reciba una ORDEN DE GUARDIA, si no se encuentra 
en la zona de control de agentes enemigos, puede transmitir 
esa orden. Cuando una orden es transmitida, todos los agentes 
OPERATIVO INQUISITORIAL amigos en la zona de aniquilación 
reciben esa orden, y a continuación resta 1 al atributo LPA de 
este agente hasta el final de su siguiente activación.</characteristic>
          </characteristics>
        </profile>
        <profile name="SEÑAL (1PA)" id="6b1c-2739-06d2-93b9" hidden="false" typeId="8f2a-d3d6-1a0c-7fa3" typeName="Unique Actions">
          <characteristics>
            <characteristic name="Unique Action" typeId="ba93-e32d-f1ac-e188">APOYO. Elige un agente OPERATIVO INQUISITORIAL 
amigo distinto a 6" o menos de este agente y visible para él. 
Hasta el final de la siguiente activación de ese agente, suma 
1 a su atributo LPA.
 Este agente no puede realizar esta acción si está en la zona 
de control de un agente enemigo.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
