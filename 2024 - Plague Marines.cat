        <profile name="Bendición del Abuelo" id="bfdb-6095-48be-670d" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Siempre que un agente enemigo que 
tenga 1 de tus fichas de veneno pierda alguna herida a 7" o 
menos de este agente, este agente recupera tantas heridas 
como las perdidas por ese agente (hasta un máximo de 3 
heridas perdidas por punto de inflexión, y solo si este agente no 
está incapacitado).
*</characteristic>
          </characteristics>
        </profile>
      </profiles>
