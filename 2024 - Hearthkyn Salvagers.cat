                <characteristic name="WR" typeId="05b8-00a1-69af-14b6">Choque, Incesante, Letal 5+</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink name="Lethal x+" id="b7be-7426-6e4f-e6a5" hidden="false" type="rule" targetId="8b97-e3e3-2857-817a" />
