              <profiles>
                <profile name="⌖ Haz de plasma EtaCarn" typeId="f25f-4b13-b724-d5a8" typeName="Weapons" hidden="false" id="6e1f-448d-d42f-49fd">
                  <characteristics>
                    <characteristic name="ATK" typeId="6056-b741-7cf3-5b43">4</characteristic>
                    <characteristic name="HIT" typeId="8044-2517-4ef7-33de">4+</characteristic>
