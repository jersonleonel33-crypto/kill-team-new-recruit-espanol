        </profile>
        <profile name="Ojo de los ancestros" typeId="f887-5881-0e6d-755c" typeName="Abilities" hidden="false" id="7d42-74a6-d450-9ab6">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">GAMBITO ESTRATÉGICO si este 
agente está en la zona de aniquilación. Elige un agente enemigo, 
o hasta dos agentes enemigos si hay tres o más agentes 
SUCESOR RECUPERADOR amigos incapacitados. Cada 
uno de esos agentes enemigos gana una de tus fichas de Agravio.</characteristic>
          </characteristics>
        </profile>
        <profile name="Cresta de campo entrelazado" typeId="f887-5881-0e6d-755c" typeName="Abilities" hidden="false" id="835e-b513-fa85-eee6">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">1 vez por batalla, cuando un dado 
de ataque inflija Daño normal a este agente, puedes ignorar ese 
daño infligido.</characteristic>
          </characteristics>
        </profile>
      </profiles>
