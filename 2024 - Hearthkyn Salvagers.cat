            <characteristic name="Wounds" typeId="74f9-f91c-b8fd-89d9">8</characteristic>
          </characteristics>
        </profile>
        <profile name="EVALUACIÓN APRESURADA (1PA)" typeId="8f2a-d3d6-1a0c-7fa3" typeName="Unique Actions" hidden="false" id="e4ce-8bd2-a094-30da">
          <characteristics>
            <characteristic name="Unique Action" typeId="ba93-e32d-f1ac-e188">Si tu marcador de Ataque o de Defensa está en la zona de 
aniquilación, retíralo. 
 Coloca tu marcador de Ataque o de Defensa en la zona 
de aniquilación.
 Este agente no puede realizar esta acción si se encuentra en 
la zona de control de un agente enemigo.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint type="max" value="-1" field="selections" scope="force" shared="true" id="fe76-34a2-d304-749b" includeChildSelections="false" />
