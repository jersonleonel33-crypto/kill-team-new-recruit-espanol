        </profile>
        <profile name="Activación en grupo" typeId="f887-5881-0e6d-755c" typeName="Abilities" hidden="false" id="bc5a-4278-e9b5-0084">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Cuando este agente quede usado, 
debes activar a continuación otro agente COMBATIENTE 
FILOSIERPE amigo apostado (si es posible) antes de que 
active tu oponente. En cuanto ese otro agente quede usado, tu 
oponente activa de manera normal (es decir, no puedes activar 
más de dos agentes sucesivos mediante esta regla).</characteristic>
          </characteristics>
        </profile>
      </profiles>
