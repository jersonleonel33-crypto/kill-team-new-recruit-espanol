        <categoryLink name="Tecnosacerdote" id="51c2-fea6-1358-b6dc" hidden="false" primary="false" targetId="f174-66a3-308a-4823" />
        <categoryLink name="Comando clado de batalla" id="21ef-e91f-bd51-8bbe" hidden="false" primary="false" targetId="545f-000d-0462-b690" />
        <categoryLink name="SUPERVISOR DE SERVIDORES DE CLADO DE BATALLA" id="2f2c-6692-8833-332b" hidden="false" primary="false" targetId="0fc5-b58d-230d-d3df" />
      </categoryLinks>
      <constraints>
        <constraint id="8e2b-5547-7971-aa55-min" field="selections" scope="bf0e-f3bd-7407-1eca" shared="true" type="min" value="1" />
        <constraint id="8e2b-5547-7971-aa55-max" field="selections" scope="bf0e-f3bd-7407-1eca" shared="true" type="max" value="1" />
      </constraints>
      <profiles>
        <profile name="SUPERVISOR DE SERVIDORES DE CLADO DE BATALLA" id="668b-d717-3500-d39a" hidden="false" typeId="5156-3fb9-39ce-7bdb" typeName="Operative">
          <characteristics>
            <characteristic name="APL" typeId="bc83-42aa-b7c1-f0b1">3</characteristic>
            <characteristic name="Move" typeId="c996-ffb3-e0b4-ecfa">6"</characteristic>
            <characteristic name="Save" typeId="3241-5548-12d6-f103">3+</characteristic>
            <characteristic name="Wounds" typeId="74f9-f91c-b8fd-89d9">9</characteristic>
          </characteristics>
        </profile>
        <profile name="ANULACIÓN DE RED (1PA)" id="a71c-76a8-054c-b456" hidden="false" typeId="8f2a-d3d6-1a0c-7fa3" typeName="Unique Actions">
          <characteristics>
            <characteristic name="Unique Action" typeId="ba93-e32d-f1ac-e188">APOYO. Elige un agente SERVIDOR CLADO DE BATALLA amigo a 6" o menos de o bien este agente o bien de un agente 
AUTOTRANSMISOR CLADO DE BATALLA amigo para REACCIONAR EN RED inmediatamente (no tienes que 
TRANSFERIR POTENCIA para ello) o realizar una acción libre de Correr. Continúa la activación de este agente tras hacerlo. 
A efectos del equipo universal Aparato de comunicaciones, el agente desde el que se determina la distancia debe controlar 
ese marcador.
 Este agente puede realizar esta acción dos veces durante su activación, pero no puede realizar esta acción si está en la zona de 
control de un agente enemigo.</characteristic>
          </characteristics>
        </profile>
        <profile name="ACUMULADOR DATACORONARIO (1PA)" id="2032-bc3f-cb52-9d74" hidden="false" typeId="8f2a-d3d6-1a0c-7fa3" typeName="Unique Actions">
          <characteristics>
            <characteristic name="Unique Action" typeId="ba93-e32d-f1ac-e188">APOYO. Determine qué agentes CLADO DE BATALLA amigos están a 6" o menos de este agente y/o de un agente 
AUTOTRANSMISOR CLADO DE BATALLA amigo, y a continuación tira 1D3. Si el resultado es igual o menor al 
número de marcadores de objetivo que esos agentes amigos disputan, ganas 1PM. A efectos del equipo universal Aparato de 
comunicaciones, el agente desde el que se determina la distancia debe controlar tu marcador de Aparato de comunicaciones para 
sumar 3" al requisito de distancia de esta regla.
 Este agente puede realizar esta acción dos veces durante su activación, pero debe elegir un agente amigo diferente cada vez y no 
puede realizarla si se encuentra en la zona de control de un agente enemigo.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
