        <selectionEntry name="OMNIESCÁNER" id="d47b-07fa-0ecd-5229" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="02c9-1647-adb6-81ff-min" field="selections" scope="parent" shared="true" type="min" value="1" />
            <constraint id="02c9-1647-adb6-81ff-max" field="selections" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <infoLinks>
            <infoLink name="Ceaseless" id="1488-8795-6e52-6a3b" hidden="false" targetId="752d-ce38-c325-4b8a" type="rule" />
          </infoLinks>
          <profiles>
            <profile name="OMNIESCÁNER (1PA)" id="c2e7-e3cb-4a00-60fc" hidden="false" typeId="8f2a-d3d6-1a0c-7fa3" typeName="Unique Actions">
              <characteristics>
                <characteristic name="Unique Action" typeId="ba93-e32d-f1ac-e188">Elige un agente enemigo a 8" o menos de este agente o 
visible para él. El agente enemigo elegido obtiene uno de 
tus marcadores de Omniescáner. Siempre que un agente 
CLADO DE BATALLA amigo dispare, combata o 
contraataque contra un agente enemigo que tenga uno de 
tus marcadores de Omniescáner, las armas de ese agente 
amigo tienen la regla de armas Incesante.
 Este agente no puede realizar esta acción si está en la zona 
de control de un agente enemigo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
