      <profiles>
        <profile name="LOBO FENRISIANO EXPLORADOR LOBO" id="ba7c-5e58-3244-88a3" hidden="false" typeId="5156-3fb9-39ce-7bdb" typeName="Operative">
          <characteristics>
            <characteristic name="APL" typeId="bc83-42aa-b7c1-f0b1">2</characteristic>
            <characteristic name="Move" typeId="c996-ffb3-e0b4-ecfa">8"</characteristic>
            <characteristic name="Save" typeId="3241-5548-12d6-f103">5+</characteristic>
            <characteristic name="Wounds" typeId="74f9-f91c-b8fd-89d9">9</characteristic>
          </characteristics>
        </profile>
        <profile name="Depredador instintivo" id="92b1-2f16-710d-621e" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Este agente solo puede realizar las 
acciones de Cargar, Correr, Retroceder, Combatir, 
Ponerse en guardia y Reposicionarse. No puede 
usar armas que no estén en su hoja de datos. Este agente 
puede realizar la acción de Cargar mientras tenga una 
orden de ocultarse.</characteristic>
          </characteristics>
        </profile>
        <profile name="Sin parar" id="1cd1-d2cc-3ac4-f7d9" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Una vez por batalla GAMBITO ESTRATÉGICO. 
Si el atributo LPA de este agente es 2 o más, este agente 
puede realizar una acción libre de Cargar, Retroceder o 
Reposicionarse. Si lo hace, hasta el final de su siguiente 
activación, resta 1 a su atributo LPA y no puede realizar ninguna 
de las acciones anteriores.</characteristic>
          </characteristics>
        </profile>
      </profiles>
