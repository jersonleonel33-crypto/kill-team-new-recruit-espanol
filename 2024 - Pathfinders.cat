          <characteristics>
            <characteristic name="APL" typeId="bc83-42aa-b7c1-f0b1">2</characteristic>
            <characteristic name="Move" typeId="c996-ffb3-e0b4-ecfa">6"</characteristic>
            <characteristic name="Save" typeId="3241-5548-12d6-f103">5+</characteristic>
            <characteristic name="Wounds" typeId="74f9-f91c-b8fd-89d9">7</characteristic>
          </characteristics>
        </profile>
        <profile name="Valor en primera línea" id="e39a-f0b3-5989-826a" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Este agente puede realizar la acción de 
Marcador telemétrico aún estando en la zona de control 
de un agente enemigo (lo cuál tiene preferencia sobre las 
condiciones normales de la acción Marcador telemétrico ). 
Además, este agente puede realizar la acción de Retroceder 
por 1PA menos.</characteristic>
          </characteristics>
        </profile>
        <profile name="Activación en grupo" id="0550-a75a-8cf0-78ee" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Cuando este agente quede usado, debes 
activar a continuación otro agente SHAS’LA RASTREADOR 
amigo apostado (si es posible) antes de que active tu oponente. 
En cuanto ese otro agente quede usado, tu oponente activa de 
manera normal (es decir, no puedes activar más de dos agentes 
sucesivos mediante esta regla).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
