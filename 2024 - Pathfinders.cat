            <characteristic name="Unique Action" typeId="ba93-e32d-f1ac-e188">Elige un agente enemigo visible para este 
agente. Hasta el final de la siguiente activación 
de ese agente, resta 1 a su atributo LPA.
 Este agente no puede realizar esta acción 
si está en la zona de control de un agente 
enemigo, o si tiene una orden de ocultarse.</characteristic>
          </characteristics>
        </profile>
        <profile name="Visión multidimensional" id="b968-373f-4b4a-bca6" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Siempre que este 
agente dispara, los agentes enemigos no pueden 
estar ofuscados.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
