        <profile name="Astucia" typeId="f887-5881-0e6d-755c" typeName="Abilities" hidden="false" id="8b2f-8d92-8edd-69c4">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">En el paso de gambito de cada fase de estrategia, si 
este agente está en la zona de aniquilación y pasas en la primera 
oportunidad que tengas, ganas 1PM. Ignora cada GAMBITO 
ESTRATÉGICO del pack de misiones (si lo hay) al determinar esto.</characteristic>
          </characteristics>
        </profile>
        <profile name="ARCHISIBARITA KABALISTA" typeId="5156-3fb9-39ce-7bdb" typeName="Operative" hidden="false" id="0177-395a-e0a0-2037">
