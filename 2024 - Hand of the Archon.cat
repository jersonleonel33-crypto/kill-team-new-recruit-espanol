          </characteristics>
        </profile>
        <profile name="Ojo para la tortura" typeId="f887-5881-0e6d-755c" typeName="Abilities" hidden="false" id="c20d-1635-5205-1960">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Una vez durante cada activación de este 
agente, si no tiene ninguna de tus fichas de Dolor cuando realiza 
una acción de Combatir o Disparar, puede obtener una de tus 
fichas de Dolor cuando elijas un blanco válido o un agente 
enemigo contra el que combatir.</characteristic>
          </characteristics>
        </profile>
      </profiles>
