      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Incensario ardiente" hidden="false" id="d028-f264-1488-ff9c">
          <profiles>
            <profile name="⌖ Incensario ardiente" typeId="f25f-4b13-b724-d5a8" typeName="Weapons" hidden="false" id="68ae-48af-05ee-ab4a">
              <characteristics>
