            <characteristic name="Wounds" typeId="74f9-f91c-b8fd-89d9">7</characteristic>
          </characteristics>
        </profile>
        <profile name="Activación en grupo" typeId="f887-5881-0e6d-755c" typeName="Abilities" hidden="false" id="73da-6fdb-9f77-baf1">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Cuando este agente quede usado, debes 
activar a continuación otro agente DEVOTO CULTO DEL 
CAOS amigo apostado (si es posible) antes de que active tu 
oponente. En cuanto ese otro agente quede usado, tu oponente 
activa de manera normal (es decir, no puedes activar más de dos 
agentes sucesivos mediante esta regla).</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint type="min" value="-1" field="selections" scope="force" shared="true" id="9667-ca6a-c684-0bc2-min" includeChildSelections="true" />
