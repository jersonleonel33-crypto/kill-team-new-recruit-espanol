        <profile name="Tormento maldito" typeId="f887-5881-0e6d-755c" typeName="Abilities" hidden="false" id="7f19-40c4-38f0-625d">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Este agente no puede usar armas que no 
figuren en su tarjeta de datos, ni realizar acciones de Recoger 
marcador, acciones únicas o acciones de misión (salvo 
Operar portillo).</characteristic>
          </characteristics>
        </profile>
        <profile name="Grandote" typeId="f887-5881-0e6d-755c" typeName="Abilities" hidden="false" id="b521-0707-3444-0b55">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Cuando tu oponente elige un blanco válido, si este 
agente tiene una orden de ocultarse no se considera a cubierto 
debido a terreno Ligero. Esto puede permitir que el agente sea 
tomado como blanco (suponiendo que sea visible), pero no le 
niega la salvación por cobertura de la que disponga.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
