      <profiles>
        <profile name="BRUJO MENTAL" typeId="5156-3fb9-39ce-7bdb" typeName="Operative" hidden="false" id="14b9-aa24-3fde-1c0a">
          <characteristics>
            <characteristic name="APL" typeId="bc83-42aa-b7c1-f0b1">2</characteristic>
            <characteristic name="Move" typeId="c996-ffb3-e0b4-ecfa">6"</characteristic>
            <characteristic name="Save" typeId="3241-5548-12d6-f103">5+</characteristic>
            <characteristic name="Wounds" typeId="74f9-f91c-b8fd-89d9">8</characteristic>
          </characteristics>
        </profile>
        <profile name="ASALTO MENTAL ATROZ (1PA)" typeId="8f2a-d3d6-1a0c-7fa3" typeName="Unique Actions" hidden="false" id="c902-e5e3-cd95-c5c6">
          <characteristics>
            <characteristic name="Unique Action" typeId="ba93-e32d-f1ac-e188">PSÍQUICA. Elige un agente enemigo 
que sea un blanco válido para este 
agente. Hasta el final de la siguiente 
activación de ese agente, resta 1 a su 
atributo LPA.
 Este agente no puede realizar esta 
acción si está en la zona de control de 
un agente enemigo.</characteristic>
          </characteristics>
        </profile>
        <profile name="VÓRTICE MALÉFICO (1PA)" typeId="8f2a-d3d6-1a0c-7fa3" typeName="Unique Actions" hidden="false" id="513e-8b90-0731-b2bd">
          <characteristics>
            <characteristic name="Unique Action" typeId="ba93-e32d-f1ac-e188">PSÍQUICA. Retira tu marcador de Vórtice maléfico de la zona de aniquilación 
(de haberlo). A continuación, coloca tu marcador de Vórtice maléfico visible para 
este agente, o sobre un terreno Aventajado de un elemento de terreno que sea 
visible para este agente. Inflige 1 daño a cada agente enemigo a 2" o menos de ese 
marcador. Además, en el paso de preparación de cada fase de estrategia, inflige 1 
daño a cada agente enemigo a 2" o menos de ese marcador.
 Este agente no puede realizar esta acción si está en la zona de control de un 
agente enemigo.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <modifiers>
        <modifier type="set" value="1" field="c82a-448b-dbdf-d60a-min">
          <conditions>
            <condition type="notInstanceOf" value="1" field="selections" scope="force" childId="default-force" shared="true" />
          </conditions>
        </modifier>
        <modifier type="set" value="1" field="c82a-448b-dbdf-d60a-max">
          <conditions>
            <condition type="notInstanceOf" value="1" field="selections" scope="force" childId="default-force" shared="true" />
          </conditions>
        </modifier>
      </modifiers>
