        <profile name="Lanzagarfios" typeId="f887-5881-0e6d-755c" typeName="Abilities" hidden="false" id="b756-d52b-7c7a-b66b">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Siempre que este agente trepe, puedes tratar la 
distancia vertical como 2" (sin importar la distancia real que 
mueva en vertical dicho agente).</characteristic>
          </characteristics>
        </profile>
