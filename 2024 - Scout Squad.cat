      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Asalto con lanzagarfios" hidden="false" id="7731-4f31-bfcd-1661">
          <profiles>
            <profile name="Asalto con lanzagarfios" typeId="f887-5881-0e6d-755c" typeName="Abilities" hidden="false" id="ef43-b872-d8b0-ad26">
              <characteristics>
                <characteristic name="Ability" typeId="3467-0678-083e-eb50">Siempre que este gente realice una 
acción de Cargar en su activación, si durante esa acción trepa, 
se deja caer, salta o su peana se mueve bajo terreno Aventajado, 
sus armas de combate tienen la regla de arma Letal 3+ hasta el 
final de dicha activación.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink name="Lethal x+" id="0982-6f6f-1a47-8a06" hidden="false" type="rule" targetId="8b97-e3e3-2857-817a" />
