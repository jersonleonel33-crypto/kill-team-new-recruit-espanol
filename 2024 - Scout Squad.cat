        <profile name="Guía y experiencia" typeId="f887-5881-0e6d-755c" typeName="Abilities" hidden="false" id="99ab-a611-a548-f526">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Una vez durante cada una de las activaciones de este agente, puedes elegir un agente ESCUADRA DE 
EXPLORADORES amigo en la zona de aniquilación. Hasta el final de la siguiente activación de ese agente, suma 1 a su atributo LPA.</characteristic>
          </characteristics>
        </profile>
        <profile name="Astartes" typeId="f887-5881-0e6d-755c" typeName="Abilities" hidden="false" id="9d6e-9734-5978-a617">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Durante la activación de este agente, puede realizar o bien dos acciones de Disparar o bien dos acciones de Combatir. 
Si han sido dos acciones de Disparar, debe elegirse al menos para una de ellas una escopeta Astartes, una pistola bólter o un bólter. 
Este agente puede reaccionar sea cual sea su orden.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="model" import="true" name="TIRADOR PESADO EXPLORADOR" hidden="false" id="9e7e-101d-aa59-0f21">
