          <infoLinks>
            <infoLink name="Brutal" id="228b-54f3-1740-dc0b" hidden="false" type="rule" targetId="5151-5449-ca81-70ed" />
            <infoLink name="Lethal x+" id="242e-7dc7-4502-59bb" hidden="false" type="rule" targetId="8b97-e3e3-2857-817a" />
          </infoLinks>
          <rules>
            <rule name="*Barrido de fase" id="72c7-fd23-c1a8-7fd1" hidden="false">
              <description>Siempre que este agente realice la acción de 
Combatir con este perfil de arma, si no resulta incapacitado 
puede realizar inmediatamente una acción libre de Combatir, 
pero debes elegir este perfil de arma, y además solo puede 
combatir contra cada agente enemigo en su zona de control una 
vez por activación o reacción usando este perfil de arma. Esto 
tiene preferencia sobre las restricciones de acciones, y puedes 
seguir realizando acciones libres de Combatir hasta que este 
agente resulte incapacitado o haya combatido contra cada 
agente enemigo en su zona de control.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
