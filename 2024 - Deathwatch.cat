        <profile name="VETERANO DISRUPTOR DE LOS VIGÍAS DE LA MUERTE" typeId="5156-3fb9-39ce-7bdb" typeName="Operative" hidden="false" id="1590-4254-268a-ed6c">
          <characteristics>
            <characteristic name="APL" typeId="bc83-42aa-b7c1-f0b1">3</characteristic>
