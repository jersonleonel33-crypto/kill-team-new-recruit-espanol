              <characteristics>
                <characteristic name="ATK" typeId="6056-b741-7cf3-5b43">5</characteristic>
                <characteristic name="HIT" typeId="8044-2517-4ef7-33de">3+</characteristic>
                <characteristic name="DMG" typeId="dd3e-ef09-5d1a-37b4">4/5</characteristic>
                <characteristic name="WR" typeId="05b8-00a1-69af-14b6">Machacar*</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="*Machacar" id="fb28-518f-1988-3751" hidden="false">
              <description>Siempre que golpees, desempata con tu oponente 
y suma 1 al resultado si este agente contra el que se usa esta 
arma tiene un atributo Heridas de 9 o menos. Si ganas, inflige 
tanto daño adicional a ese agente como la diferencia entre los 
resultados (hasta un máximo de 3 daños adicionales).</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
