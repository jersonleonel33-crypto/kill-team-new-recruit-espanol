    <selectionEntry type="model" import="true" name="FRANCOTIRADOR TRAIDOR" hidden="false" id="969d-74e0-7512-0b69">
      <profiles>
        <profile name="FRANCOTIRADOR TRAIDOR" typeId="5156-3fb9-39ce-7bdb" typeName="Operative" hidden="false" id="35f8-0644-db82-8c7e">
          <characteristics>
            <characteristic name="APL" typeId="bc83-42aa-b7c1-f0b1">2</characteristic>
            <characteristic name="Move" typeId="c996-ffb3-e0b4-ecfa">6"</characteristic>
