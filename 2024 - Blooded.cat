        </profile>
        <profile name="Icono Ungido" typeId="f887-5881-0e6d-755c" typeName="Abilities" hidden="false" id="ddbe-af66-2275-2aa8">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Una vez por punto de inflexión, cuando un 
agente UNGIDO amigo con una de tus fichas de Ungido sea 
incapacitado estando a 6" o menos de este agente, puedes 
recuperar esa ficha.</characteristic>
          </characteristics>
        </profile>
        <profile name="Liderar por la fuerza" typeId="f887-5881-0e6d-755c" typeName="Abilities" hidden="false" id="9bfa-9eb2-6848-6469">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Mientras este agente tenga una de tus 
fichas de Ungido o se encuentre completamente en el territorio 
de tu oponente, se considerará que está bajo la MIRADA DE 
LOS DIOSES.</characteristic>
          </characteristics>
        </profile>
      </profiles>
