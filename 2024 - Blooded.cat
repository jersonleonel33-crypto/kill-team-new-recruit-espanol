              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="*Escudo" id="6c71-915a-8e0b-5f9d" hidden="false">
              <description>Cuando este agente combate o contraataca con esta 
arma, cada uno de tus bloqueos puede asignarse para bloquear 
dos éxitos sin resolver (en lugar de uno).</description>
            </rule>
          </rules>
