          </characteristics>
        </profile>
        <profile name="Robusto" typeId="f887-5881-0e6d-755c" typeName="Abilities" hidden="false" id="61a9-e436-3cfb-8cb5">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Cuando este agente combate o contraataca, o un 
agente le dispara, los Daños normales de 3 o más le infligen 1 
daño menos.</characteristic>
          </characteristics>
        </profile>
