        <profile name="Vigilancia en combate cerrado" typeId="f887-5881-0e6d-755c" typeName="Abilities" hidden="false" id="d4f6-8f4f-4979-34c9">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Este agente puede realizar la 
acción Disparar (salvo En guardia) mientras se encuentre 
en la zona de control de un agente enemigo, pero solo si no ha 
realizado la acción Cargar durante esa activación, o si es una 
reacción. Este agente no tiene prohibido realizar la acción de 
Cargar tras realizar la acción de Disparar.</characteristic>
          </characteristics>
        </profile>
      </profiles>
