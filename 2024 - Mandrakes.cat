        <profile name="MANDRÁGORA FAUCES FÚNEBRES" typeId="5156-3fb9-39ce-7bdb" typeName="Operative" hidden="false" id="df97-31fc-0fe0-368b">
          <characteristics>
            <characteristic name="APL" typeId="bc83-42aa-b7c1-f0b1">2</characteristic>
            <characteristic name="Move" typeId="c996-ffb3-e0b4-ecfa">7"</characteristic>
