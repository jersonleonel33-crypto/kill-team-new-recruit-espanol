              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="ESTIMULANTES DE COMBATE" id="d992-12ad-e103-be9f" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="97c0-79fa-7b2e-9831" field="selections" scope="parent" shared="true" type="max" value="1" />
          </constraints>
          <profiles>
            <profile name="ESTIMULANTES DE COMBATE" id="287a-98d8-dc75-caaa" hidden="false" typeId="0d20-7175-9ecb-8bde" typeName="Equipment">
              <characteristics>
                <characteristic name="Equipment" typeId="0e12-ef21-83f3-9fc6">TEMPESTUS AQUILONS
EQUIPO DE FACCIÓN
ESTIMULANTES DE COMBATE
El uso de estimulantes de combate aprobados por
el Munitorum es una práctica estándar entre los
Tempestus Aquilons, que pueden tener que permanecer
alerta y combatiendo durante muchos días seguidos.
Puedes ignorar cualquier cambio al atributo
Movimiento de los agentes TEMPESTUS
AQUILON amigos por estar lesionados.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
