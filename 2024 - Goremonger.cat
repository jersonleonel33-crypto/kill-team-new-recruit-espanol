          <profiles>
            <profile name="⚔ Filo ritual" id="2ebd-4949-064f-c2c5" hidden="false" typeId="f25f-4b13-b724-d5a8" typeName="Weapons">
              <characteristics>
                <characteristic name="ATK" typeId="6056-b741-7cf3-5b43">4</characteristic>
