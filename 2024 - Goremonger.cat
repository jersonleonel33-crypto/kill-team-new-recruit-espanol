        </profile>
        <profile name="Apoteosis inminente" id="aa6e-f671-3dfb-92b6" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Una vez por batalla, cuando un dado de 
ataque inflija daño normal a este agente, puedes ignorar ese 
daño infligido.</characteristic>
          </characteristics>
        </profile>
