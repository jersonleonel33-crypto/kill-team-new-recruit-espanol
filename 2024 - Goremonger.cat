        <profile name="RITUAL DE TRANSFUSIÓN (1PA)" id="4d5c-0267-b43f-4c7c" hidden="false" typeId="8f2a-d3d6-1a0c-7fa3" typeName="Unique Actions">
          <characteristics>
            <characteristic name="Unique Action" typeId="ba93-e32d-f1ac-e188">Disminuye el DEPÓSITO SANGRIENTO de este agente. 
En lugar de usar una regla SANGUAVITAE, puedes 
incrementar el DEPÓSITO SANGRIENTO de otro agente 
SIEMBRASANGRE amigo distinto a 8" o menos de 
este agente.
 Este agente no puede realizar esta acción si se encuentra en 
la zona de control de un agente enemigo, o si su DEPÓSITO 
SANGRIENTO está vacío.</characteristic>
          </characteristics>
        </profile>
      </profiles>
