        <profile name="Portaicono" id="8064-ef63-c6ff-5a14" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Al determinar el control de 
un marcador, trata el atributo LPA de 
esta agente como si fuera 1 mayor de 
lo que es. Ten en cuenta que esto no es 
un cambio a su atributo LPA, de modo 
que cualquier cambio será acumulable 
con esto.</characteristic>
          </characteristics>
        </profile>
        <profile name="ALZAR ICONO (1PA)" id="edb3-91a0-f34c-877d" hidden="false" typeId="8f2a-d3d6-1a0c-7fa3" typeName="Unique Actions">
          <characteristics>
            <characteristic name="Unique Action" typeId="ba93-e32d-f1ac-e188">Ganas 1 punto de fe. Si esta agente controla un marcador de objetivo, además 
ganas tantos puntos de fe como el número del punto de inflexión actual.
 Esta agente solo puede realizar esta acción una vez por punto de inflexión, y no 
puede realizarla si está en la zona de control de un agente enemigo.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
