        <profile name="¡DAKKA A TODA MECHA! (1PA)" typeId="8f2a-d3d6-1a0c-7fa3" typeName="Unique Actions" hidden="false" id="30cf-f288-cbf5-b4ff">
          <characteristics>
            <characteristic name="Unique Action" typeId="ba93-e32d-f1ac-e188">Realiza una acción libre de Correr y una acción libre de 
Disparar con este agente en cualquier orden. Solo puedes 
elegir una dakkatralladora para esa acción de Disparar.
 Este agente no puede realizar esta acción mientras esté en la 
zona de control de un agente enemigo, o mientras tenga una 
orden de ocultarse.</characteristic>
          </characteristics>
        </profile>
      </profiles>
