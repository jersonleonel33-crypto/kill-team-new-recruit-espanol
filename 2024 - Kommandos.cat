        <profile name="¡MANOZ A LA OBRA! (1PA)" typeId="8f2a-d3d6-1a0c-7fa3" typeName="Unique Actions" hidden="false" id="6975-995d-fca4-8285">
          <characteristics>
            <characteristic name="Unique Action" typeId="ba93-e32d-f1ac-e188">APOYO. Elige un agente ORKOMANDO amigo distinto 
(salvo GARRAPATO BOMBA) a 6" o menos de este 
agente y visible para él. Hasta el final de la siguiente 
activación de ese agente, suma 1 a su atributo LPA.
 Este agente no puede realizar esta acción si se encuentra en 
la zona de control de un agente enemigo, o como reacción.</characteristic>
          </characteristics>
        </profile>
        <profile name="La hora de laz tortaz" typeId="f887-5881-0e6d-755c" typeName="Abilities" hidden="false" id="ac71-6cb6-ffac-daa3">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Este agente puede realizar 2 acciones de Combatir durante su activación.</characteristic>
          </characteristics>
        </profile>
      </profiles>
