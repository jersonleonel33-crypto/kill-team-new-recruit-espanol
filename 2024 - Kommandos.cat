        <profile name="Tengo un plan, chavalez" typeId="f887-5881-0e6d-755c" typeName="Abilities" hidden="false" id="ff85-8b76-e761-9a41">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Una vez por 
activación de este agente, puede realizar 
una acción de Colocar marcador, 
Recoger marcador o una acción de 
misión por 1 PA menos.</characteristic>
          </characteristics>
        </profile>
        <profile name="EZKUCHADME (1PA)" typeId="8f2a-d3d6-1a0c-7fa3" typeName="Unique Actions" hidden="false" id="cf79-43b1-280e-7831">
          <characteristics>
            <characteristic name="Unique Action" typeId="ba93-e32d-f1ac-e188">APOYO. Elige un agente 
ORKOMANDO amigo distinto 
(salvo GARRAPATO BOMBA) a 
6" o menos de este agente y visible 
para él. Hasta el final de la siguiente 
activación de ese agente, suma 1 a su 
atributo LPA.
 Este agente no puede realizar esta 
acción si está en la zona de control de 
un agente enemigo.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
