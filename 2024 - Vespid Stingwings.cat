        <profile name="Lluvia de neutrones" id="f3ac-f188-010d-a871" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Una vez durante cada activación de un 
agente enemigo, tan pronto como dicho agente enemigo se 
encuentre a 2" o menos de uno de tus marcadores de lluvia 
de neutrones, inflígele 1D3 daños (este efecto no se acumula 
con más de un marcador).</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
