      <profiles>
        <profile name="Casco de comunión" id="5717-72cb-c405-92eb" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Una vez durante cada una de las 
activaciones de este agente, elegir 1 de las siguientes opciones:
• Gastar 1 punto de comunión de manera gratuita. 
• Gasta 1 punto de comunión y elige 1 agente AGUIJÓN 
ALADO VÉSPID amigo a 3" o menos de este agente. Ese 
otro agente aliado puede realizar inmediatamente una acción 
de misión libre de 1PA (aún debes gastar 1 punto de Comunión 
para que realice esa acción normalmente, y esto no se puede 
ignorar usando el equipo Estimulante de Convergencia).</characteristic>
          </characteristics>
        </profile>
        <profile name="Entrar en comunión" id="09ab-7f18-eb5f-c319" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Al elegir tus agentes para la batalla, elige 
también un ardid de estrategia AGUIJÓN ALADO VÉSPID . 
Si este agente está en la zona de aniquilación y fuera de la zona 
de control de todo agente enemigo, dicho ardid te cuesta 0PM.</characteristic>
          </characteristics>
        </profile>
        <profile name="HIMENÓPTERO VÉSPID" id="57ca-623f-1cc9-c909" hidden="false" typeId="5156-3fb9-39ce-7bdb" typeName="Operative">
          <characteristics>
            <characteristic name="APL" typeId="bc83-42aa-b7c1-f0b1">2</characteristic>
            <characteristic name="Move" typeId="c996-ffb3-e0b4-ecfa">6"</characteristic>
