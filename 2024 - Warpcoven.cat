        <categoryLink name="Configuration" hidden="false" id="7bb0-6a09-9d19-365b" targetId="874b-0390-e5e2-1daa" />
        <categoryLink name="Operative" hidden="false" id="cb36-919c-f846-f423" targetId="cf83-4496-b58e-ac82">
