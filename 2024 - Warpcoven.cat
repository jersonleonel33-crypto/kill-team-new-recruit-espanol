        <profile name="CUERNO DE LA MANADA (0PA)" typeId="8f2a-d3d6-1a0c-7fa3" typeName="Unique Actions" hidden="false" id="bffd-d9f7-ee6d-4d3c">
          <characteristics>
            <characteristic name="Unique Action" typeId="ba93-e32d-f1ac-e188">Hasta el Paso de preparación de la siguiente fase de 
estrategia, suma 1" al atributo Movimiento de los agentes 
TZAANGOR AQUELARRE DISFORME amigos.
 Este agente no puede realizar esta acción si se encuentra en 
la zona de control de un agente enemigo.</characteristic>
          </characteristics>
        </profile>
      </profiles>
