      <profiles>
        <profile name="HECHICERO DEL DESTINO" typeId="5156-3fb9-39ce-7bdb" typeName="Operative" hidden="false" id="4a80-583e-dc05-108c">
          <characteristics>
            <characteristic name="APL" typeId="bc83-42aa-b7c1-f0b1">3</characteristic>
