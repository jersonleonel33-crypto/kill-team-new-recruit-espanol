          </characteristics>
        </profile>
        <profile name="Puño del Patriarca" id="bc58-bd6b-ee93-5095" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Este agente puede realizar o bien dos acciones de Combatir o 
bien dos acciones de Disparar durante su activación.</characteristic>
          </characteristics>
        </profile>
        <profile name="Cerebro" id="013a-611f-8c3e-556b" hidden="false" typeId="f887-5881-0e6d-755c" typeName="Abilities">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Una vez por punto de inflexión, tras tirar para determinar la iniciativa, si este 
agente está en la zona de aniquilación puedes elegir una de las siguientes opciones (solo 
puedes elegir cada opción una vez por batalla):
• Sumar 1 al resultado de tu tirada.
• Si no tuviste la iniciativa en el punto de inflexión anterior, repetir tu tirada.</characteristic>
          </characteristics>
        </profile>
        <profile name="CONSPIRAR" id="2d51-1feb-f7d7-1c07" hidden="false" typeId="8f2a-d3d6-1a0c-7fa3" typeName="Unique Actions">
          <characteristics>
            <characteristic name="Unique Action" typeId="ba93-e32d-f1ac-e188">Ganas 1PM.
 Este agente no puede realizar esta 
acción si está en la zona de control de 
un agente enemigo, ni más de una vez 
por punto de inflexión.</characteristic>
          </characteristics>
        </profile>
      </profiles>
