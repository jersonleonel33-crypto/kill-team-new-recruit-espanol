        <profile name="Blindado" typeId="f887-5881-0e6d-755c" typeName="Abilities" hidden="false" id="4ee4-ab62-cd64-06fd">
          <characteristics>
            <characteristic name="Ability" typeId="3467-0678-083e-eb50">Cuando un agente enemigo dispare a este agente, 
o este agente combata o contraataque, tu oponente no puede 
guardar como éxitos críticos los resultados de dados de ataque 
inferiores a 6 (p. ej. de resultas de las reglas de armas Letal, 
Desgarradora o Severa).</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Kiebranudilloz" hidden="false" id="ced0-4c59-f0d4-dbd5">
