          </constraints>
          <profiles>
            <profile name="⚔ Palokabum (golpetazo)" typeId="f25f-4b13-b724-d5a8" typeName="Weapons" hidden="false" id="c135-df80-2688-6a0a">
              <characteristics>
                <characteristic name="ATK" typeId="6056-b741-7cf3-5b43">4</characteristic>
