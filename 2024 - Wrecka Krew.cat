              </profiles>
              <infoLinks>
                <infoLink name="Heavy" id="0791-6e52-c54e-2788" hidden="false" type="rule" targetId="816e-44a2-6be4-6a9a" />
                <infoLink name="Limited x" id="ab48-9898-baa9-7d2b" hidden="false" type="rule" targetId="bf37-3388-40d5-eb72" />
              </infoLinks>
              <rules>
                <rule name="*Indukzión" id="31f7-ad78-467f-7e72" hidden="false">
                  <description>No selecciones un blanco válido. En su lugar, sitúa 
tu marcador de Indukzión visible para este agente, o en terreno 
ventajoso de un elemento de terreno visible para este agente. Ese 
marcador gana 1 punto de Indukzión (usa las fichas de puntos de 
Indukzión); luego tira los dados de ataque: el marcador gana 1 
punto de Indukzión adicional por cada éxito (hasta un máximo de 
3 puntos adicionales). Inflige 1D3 de daño por separado a cada
agente completamente a x" o menos de ese marcador, donde x equivale a los 
puntos de Indukzión de ese marcador. Después la acción finaliza.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Batería de kobetez" hidden="false" id="8fdb-0983-2bd7-3dfa">
              <profiles>
                <profile name="⌖ Batería de kobetez" typeId="f25f-4b13-b724-d5a8" typeName="Weapons" hidden="false" id="844b-060f-a1f4-efd6">
